# Copy this file to .env and fill in your own values. Never commit .env.

# Garmin Connect credentials (only needed to run sync_data.py).
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Where the Garmin login session/token is cached after the first login,
# so subsequent syncs don't need to re-authenticate (or re-prompt for MFA).
GARMIN_TOKEN_STORE=~/.garminconnect

# The Monday Week 1 of the plan starts. The plan itself (plan_data.py) is a
# fixed 14-week build, so race day (Sunday of week 14) is derived from this.
# Defaults to this plan's actual start date, landing race day on
# Sunday, November 1, 2026 (the 2026 NYC Marathon).
BLOCK_START_DATE=2026-07-27
